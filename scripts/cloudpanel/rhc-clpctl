#!/usr/bin/env bash
#
# rhc-clpctl — root-side allowlist wrapper around CloudPanel's `clpctl`.
#
# Install to /usr/local/bin/rhc-clpctl, owned by root:root, mode 0755, and grant
# the panel's system user permission to run ONLY this path via sudo:
#
#   # /etc/sudoers.d/rhc-clpctl   (visudo -f /etc/sudoers.d/rhc-clpctl)
#   rhcsolutions_com ALL=(root) NOPASSWD: /usr/local/bin/rhc-clpctl
#
# WHY THIS FILE EXISTS.
# The obvious sudoers rule is `NOPASSWD: /usr/bin/clpctl`, and it is a mistake:
# it grants the web app every clpctl verb forever, including ones added by future
# CloudPanel releases. This wrapper is the thing sudo permits, and it re-derives
# the allowlist here, on the root side. The panel's TypeScript validation is a
# usability layer; THIS is the security boundary. Assume the caller is hostile.
#
# What it enforces:
#   - Only the commands in the table below, each with ONLY its own flags. A flag
#     that is fine on one verb (--file on db:export) is refused on every other.
#   - Every value is checked against the same shape as the panel's validators,
#     never looser.
#   - File arguments are confined to two fixed, root-owned directories, because
#     clpctl reads and writes them as root:
#       db:export writes      -> /var/backups/rhc-clpctl/<name>
#       db:import, site:install:certificate read
#                             -> /var/lib/rhc-clpctl/import/<name>
#     A bare <name> only (no subdirectories), the directory must be owned by root
#     and not group/world-writable, and the file must not be a symlink. Without
#     this, `db:export --file=/etc/passwd` would have root overwrite any file on
#     the host (2026-10-05 review), and a cert/import path could make root read
#     any file into a place the caller can see.
#
# Destructive verbs are refused unless the marker file exists:
#   touch /etc/rhc-clpctl-allow-destructive
# That marker is root-owned, so a compromised web app cannot grant itself
# deletion rights by flipping a database row.
#
# Tests: scripts/cloudpanel/test-rhc-clpctl.sh (runs against a stub clpctl).

set -euo pipefail
export LC_ALL=C

# Binary, marker, directories and the owner they must have are FIXED whenever we
# run under sudo. Honouring $CLPCTL_BIN from a sudo caller would be a
# root-execution hole the moment anyone adds env_keep to the sudoers rule: point
# it at /tmp/evil and the wrapper runs that as root. sudo sets SUDO_USER, so we
# key off it and only allow overrides for direct (test-harness) invocation.
if [ -n "${SUDO_USER:-}" ] || [ "$(id -u 2>/dev/null || echo 0)" = "0" ]; then
  CLPCTL="/usr/bin/clpctl"
  DESTRUCTIVE_MARKER="/etc/rhc-clpctl-allow-destructive"
  EXPORT_DIR="/var/backups/rhc-clpctl"
  IMPORT_DIR="/var/lib/rhc-clpctl/import"
  OWNER_UID=0
else
  CLPCTL="${CLPCTL_BIN:-/usr/bin/clpctl}"
  DESTRUCTIVE_MARKER="${CLPCTL_DESTRUCTIVE_MARKER:-/etc/rhc-clpctl-allow-destructive}"
  EXPORT_DIR="${RHC_CLPCTL_EXPORT_DIR:-/var/backups/rhc-clpctl}"
  IMPORT_DIR="${RHC_CLPCTL_IMPORT_DIR:-/var/lib/rhc-clpctl/import}"
  OWNER_UID="$(id -u)"
fi

die() {
  echo "rhc-clpctl: $*" >&2
  exit 64
}

log() {
  # Best-effort audit trail on the host itself, independent of the panel's DB.
  command -v logger >/dev/null 2>&1 && logger -t rhc-clpctl -- "$*" || true
}

[ "$#" -ge 1 ] || die "no command given"

COMMAND="$1"
shift

# --- the allowlist -------------------------------------------------------------
# One entry per verb: the flags it may take, and whether it is destructive.
# Mirrors COMMANDS in src/lib/cloudpanel/clpctl.ts. A literal case match, so an
# empty, globbed or path-like command can never match.
DESTRUCTIVE=0
case "$COMMAND" in
  site:add:nodejs)        FLAGS="domainName nodejsVersion appPort siteUser siteUserPassword" ;;
  site:add:static)        FLAGS="domainName siteUser siteUserPassword" ;;
  site:add:php)           FLAGS="domainName phpVersion vhostTemplate siteUser siteUserPassword" ;;
  site:add:python)        FLAGS="domainName pythonVersion appPort siteUser siteUserPassword" ;;
  site:add:reverse-proxy) FLAGS="domainName reverseProxyUrl siteUser siteUserPassword" ;;
  lets-encrypt:install:certificate) FLAGS="domainName subjectAlternativeName" ;;
  db:add)                 FLAGS="domainName databaseName databaseUserName databaseUserPassword" ;;
  db:export)              FLAGS="databaseName file" ;;
  user:add)               FLAGS="userName email firstName lastName password role sites timezone status" ;;
  user:reset:password)    FLAGS="userName password" ;;
  user:list|cloudflare:update:ips|vhost-templates:list) FLAGS="" ;;
  site:delete)            FLAGS="domainName force"; DESTRUCTIVE=1 ;;
  user:delete)            FLAGS="userName"; DESTRUCTIVE=1 ;;
  user:disable:mfa)       FLAGS="userName"; DESTRUCTIVE=1 ;;
  db:import)              FLAGS="databaseName file"; DESTRUCTIVE=1 ;;
  site:install:certificate) FLAGS="domainName privateKey certificate certificateChain"; DESTRUCTIVE=1 ;;
  *)
    log "DENIED unknown command $COMMAND"
    die "command not allowed: $COMMAND"
    ;;
esac

if [ "$DESTRUCTIVE" = 1 ] && [ ! -f "$DESTRUCTIVE_MARKER" ]; then
  log "DENIED destructive $COMMAND (marker $DESTRUCTIVE_MARKER absent)"
  die "destructive command '$COMMAND' refused: $DESTRUCTIVE_MARKER does not exist"
fi

flag_allowed() {
  local f
  [ -n "$1" ] || return 1
  for f in $FLAGS; do [ "$f" = "$1" ] && return 0; done
  return 1
}

# --- value shapes (same as the panel's validators, never looser) -----------------
LABEL='[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
DOMAIN_RE="^(${LABEL}\.)+${LABEL}$"
SITE_USER_RE='^[a-z_][a-z0-9_-]{0,31}$'
USER_NAME_RE='^[A-Za-z0-9._-]{1,64}$'
DB_IDENT_RE='^[A-Za-z0-9_-]{1,64}$'
EMAIL_RE='^[^[:space:]@<>"'"'"'\\]{1,64}@[A-Za-z0-9.-]{1,180}\.[A-Za-z]{2,24}$'
VERSION_RE='^[0-9]{1,3}(\.[0-9]{1,3}){0,2}$'
PORT_RE='^[0-9]{1,5}$'
ROLE_RE='^[a-z][a-z-]{0,31}$'
STATUS_RE='^(0|1|active|inactive|enabled|disabled)$'
TIMEZONE_RE='^(UTC|[A-Za-z][A-Za-z_-]{0,31}/[A-Za-z0-9_+-]{1,48}(/[A-Za-z0-9_+-]{1,48})?)$'
TEMPLATE_RE='^[A-Za-z0-9 ._-]{1,64}$'
URL_RE='^https?://[A-Za-z0-9._:/-]+$'
FILE_NAME_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$'

is_domain() {
  [ "${#1}" -le 253 ] && [[ $1 =~ $DOMAIN_RE ]]
}

is_domain_list() {
  local part parts
  IFS=',' read -r -a parts <<< "$1"
  [ "${#parts[@]}" -ge 1 ] || return 1
  for part in "${parts[@]}"; do
    part="${part#"${part%%[! ]*}"}"   # trim leading spaces
    part="${part%"${part##*[! ]}"}"   # trim trailing spaces
    is_domain "$part" || return 1
  done
}

# The directory must be a real directory (not a symlink), owned by root and not
# writable by group or others — otherwise the caller could plant a symlink in it
# and steer root's read or write anywhere.
secure_dir() {
  local dir="$1" create="$2" uid mode
  if [ ! -e "$dir" ] && [ "$create" = 1 ]; then
    mkdir -p -m 0700 -- "$dir" || die "cannot create $dir"
  fi
  { [ -d "$dir" ] && [ ! -L "$dir" ]; } || die "$dir is missing or not a real directory"
  read -r uid mode < <(stat -c '%u %a' -- "$dir")
  [ "$uid" = "$OWNER_UID" ] || die "$dir must be owned by uid $OWNER_UID"
  (( (8#$mode & 8#022) == 0 )) || die "$dir must not be group- or world-writable"
}

# confine_path <flag> <value> <dir> <read|write>
confine_path() {
  local flag="$1" value="$2" dir="$3" mode="$4" name
  name="${value#"$dir"/}"
  [ "$value" = "$dir/$name" ] || die "--$flag must be a file directly inside $dir"
  [[ $name =~ $FILE_NAME_RE ]] || die "--$flag: file name must be letters, digits, '.', '_' or '-' (no subdirectories)"
  if [ "$mode" = read ]; then
    secure_dir "$dir" 0
    { [ -f "$value" ] && [ ! -L "$value" ]; } || die "--$flag: $value must be an existing regular file, not a symlink"
  else
    secure_dir "$dir" 1
    [ ! -L "$value" ] || die "--$flag: $value is a symlink"
    { [ ! -e "$value" ] || [ -f "$value" ]; } || die "--$flag: $value exists and is not a regular file"
  fi
}

# --- argument validation ----------------------------------------------------------
# Accepted shapes are exactly:
#   --flagName=value    (a flag this command allows; value must match its shape)
#   --force             (the one valueless flag, site:delete only)
SEEN=" "
for arg in "$@"; do
  case "$arg" in
    --force)
      flag_allowed force || die "flag not allowed for $COMMAND: --force"
      flag="force"
      ;;
    --*=*)
      flag="${arg%%=*}"
      flag="${flag#--}"
      value="${arg#*=}"

      flag_allowed "$flag" && [ "$flag" != force ] || die "flag not allowed for $COMMAND: --$flag"
      [ -n "$value" ] || die "empty value for --$flag"
      [ "${#value}" -le 1024 ] || die "value too long for --$flag"
      # Refuse control characters (newlines included) outright.
      [[ $value =~ [[:cntrl:]] ]] && die "control character in --$flag"

      case "$flag" in
        domainName)
          is_domain "$value" || die "--$flag must be a domain name" ;;
        sites|subjectAlternativeName)
          is_domain_list "$value" || die "--$flag must be a comma-separated list of domains" ;;
        siteUser)
          [[ $value =~ $SITE_USER_RE ]] || die "--$flag must match $SITE_USER_RE"
          # site:add creates this system user. Pointing it at an account that
          # already exists (root, clp, the panel's own user...) is never right.
          ! getent passwd "$value" >/dev/null 2>&1 || die "--$flag: system user '$value' already exists"
          ;;
        userName)
          [[ $value =~ $USER_NAME_RE ]] || die "--$flag must match $USER_NAME_RE" ;;
        databaseName|databaseUserName)
          [[ $value =~ $DB_IDENT_RE ]] || die "--$flag must match $DB_IDENT_RE" ;;
        email)
          [[ $value =~ $EMAIL_RE ]] || die "--$flag must be an email address" ;;
        firstName|lastName)
          [ "${#value}" -le 256 ] || die "--$flag is too long" ;;
        password|siteUserPassword|databaseUserPassword)
          { [ "${#value}" -ge 8 ] && [ "${#value}" -le 512 ]; } || die "--$flag must be 8-128 characters" ;;
        appPort)
          { [[ $value =~ $PORT_RE ]] && [ "$((10#$value))" -ge 1 ] && [ "$((10#$value))" -le 65535 ]; } \
            || die "--$flag must be a port number (1-65535)" ;;
        nodejsVersion|phpVersion|pythonVersion)
          [[ $value =~ $VERSION_RE ]] || die "--$flag must be a version number" ;;
        role)
          [[ $value =~ $ROLE_RE ]] || die "--$flag must match $ROLE_RE" ;;
        status)
          [[ ${value,,} =~ $STATUS_RE ]] || die "--$flag must be 0, 1, active, inactive, enabled or disabled" ;;
        timezone)
          [[ $value =~ $TIMEZONE_RE ]] || die "--$flag must be a timezone like Europe/Berlin" ;;
        vhostTemplate)
          [[ $value =~ $TEMPLATE_RE ]] || die "--$flag must match $TEMPLATE_RE" ;;
        reverseProxyUrl)
          [[ $value =~ $URL_RE ]] || die "--$flag must be an http(s) URL" ;;
        file)
          if [ "$COMMAND" = db:export ]; then
            confine_path "$flag" "$value" "$EXPORT_DIR" write
          else
            confine_path "$flag" "$value" "$IMPORT_DIR" read
          fi
          ;;
        privateKey|certificate|certificateChain)
          confine_path "$flag" "$value" "$IMPORT_DIR" read ;;
        *)
          # Every flag in the table above has a shape here. Reaching this means
          # the two lists drifted — refuse rather than pass an unchecked value.
          die "no validator for --$flag" ;;
      esac
      ;;
    *)
      die "unexpected argument: $arg"
      ;;
  esac
  case "$SEEN" in
    *" $flag "*) die "--$flag given more than once" ;;
  esac
  SEEN="$SEEN$flag "
done

[ -x "$CLPCTL" ] || die "clpctl not found or not executable at $CLPCTL"

# Log the invocation with password-bearing flags masked.
SAFE_LOG="$COMMAND"
for arg in "$@"; do
  case "$arg" in
    --siteUserPassword=*|--databaseUserPassword=*|--password=*)
      SAFE_LOG="$SAFE_LOG ${arg%%=*}=********"
      ;;
    *)
      SAFE_LOG="$SAFE_LOG $arg"
      ;;
  esac
done
log "RUN $SAFE_LOG (invoked by uid=${SUDO_UID:-unknown} user=${SUDO_USER:-unknown})"

exec "$CLPCTL" "$COMMAND" "$@"
